# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log
crash.log
crash.*.log

# Sensitive variable files — never commit these
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plan files may contain secrets
*.tfplan
*.plan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Generated summary files produced by this module
demo-summary-*.txt

# macOS
.DS_Store

# Editor directories
.idea/
.vscode/
*.swp
*.swo
